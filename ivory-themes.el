;;; Commentary:

;; Ivory is a pair of minimal monochromatic themes.  The light and dark
;; variants share one semantic palette and face generator, keeping the theme
;; easy to tune while still covering common built-in and third-party faces.

;;; Code:

(defgroup ivory-themes nil
  "User options for the Ivory themes."
  :group 'faces
  :prefix "ivory-themes-"
  :tag "Ivory Themes")

(defcustom ivory-themes-bold-constructs t
  "When non-nil, use bold weight to create syntax and UI contrast."
  :type 'boolean
  :group 'ivory-themes)

(defcustom ivory-themes-italic-constructs nil
  "When non-nil, allow italic text in faces that conventionally use it."
  :type 'boolean
  :group 'ivory-themes)

(defcustom ivory-themes-soft-backgrounds nil
  "When non-nil, avoid pure white and pure black editor backgrounds.

The default is nil, so `ivory-light' uses pure white and `ivory-dark'
uses pure black.  Set this before loading or reloading a theme to use a
slightly softened background instead."
  :type 'boolean
  :group 'ivory-themes)

(defcustom ivory-themes-common-palette-overrides nil
  "Palette overrides shared by all Ivory themes.

Each entry has the form (NAME . HEX-COLOR).  The palette names are the
keys in `ivory-themes-palettes'.  Set this before loading or reloading an
Ivory theme."
  :type '(alist :key-type symbol :value-type string)
  :group 'ivory-themes)

(defcustom ivory-themes-light-palette-overrides nil
  "Palette overrides for `ivory-light'.

This uses the same format as `ivory-themes-common-palette-overrides'."
  :type '(alist :key-type symbol :value-type string)
  :group 'ivory-themes)

(defcustom ivory-themes-dark-palette-overrides nil
  "Palette overrides for `ivory-dark'.

This uses the same format as `ivory-themes-common-palette-overrides'."
  :type '(alist :key-type symbol :value-type string)
  :group 'ivory-themes)

(defun ivory-themes--gray (channel)
  "Return a neutral gray hex color for 8-bit CHANNEL."
  (unless (and (integerp channel) (<= 0 channel 255))
    (user-error "Ivory gray channel must be an integer from 0 through 255"))
  (format "#%02x%02x%02x" channel channel channel))

(defun ivory-themes--resolve-palette-value (value)
  "Resolve a palette VALUE into a hex color string."
  (if (and (consp value) (eq (car value) 'gray))
      (ivory-themes--gray (cadr value))
    value))

(defun ivory-themes--resolve-palette-spec (spec)
  "Resolve grayscale entries in palette SPEC."
  (mapcar (lambda (entry)
            (cons (car entry) (ivory-themes--resolve-palette-value (cdr entry))))
          spec))

(defun ivory-themes--resolve-palette-specs (specs)
  "Resolve grayscale entries in palette SPECS."
  (mapcar (lambda (entry)
            (cons (car entry) (ivory-themes--resolve-palette-spec (cdr entry))))
          specs))

