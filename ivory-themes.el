(defun ivory-themes--variant (theme)
  "Return the palette variant for THEME."
  (pcase theme
    ('ivory-light 'light)
    ('ivory-dark 'dark)
    (_ (user-error "Unknown Ivory theme: %s" theme))))

(defun ivory-themes--current-theme ()
  "Return the currently enabled Ivory theme, or `ivory-light'."
  (cond
   ((memq 'ivory-dark custom-enabled-themes) 'ivory-dark)
   ((memq 'ivory-light custom-enabled-themes) 'ivory-light)
   (t 'ivory-light)))

;;;###autoload
(defun ivory-themes-load (theme)
  "Load Ivory THEME after disabling other enabled themes."
  (interactive
   (list (intern (completing-read "Load Ivory theme: " '(ivory-light ivory-dark)
                                  nil t nil nil "ivory-light"))))
  (dolist (enabled custom-enabled-themes)
    (unless (eq enabled theme)
      (disable-theme enabled)))
  (if (memq theme custom-known-themes)
      (progn
        (enable-theme theme)
        (ivory-themes--apply theme (ivory-themes--variant theme)))
    (load-theme theme t)))

;;;###autoload
(defun ivory-themes-toggle ()
  "Toggle between `ivory-light' and `ivory-dark'."
  (interactive)
  (ivory-themes-load
   (if (memq 'ivory-light custom-enabled-themes)
       'ivory-dark
     'ivory-light)))

;;;###autoload
(defun ivory-themes-toggle-soft-backgrounds ()
  "Toggle softened backgrounds and reload the current Ivory theme."
  (interactive)
  (setq ivory-themes-soft-backgrounds (not ivory-themes-soft-backgrounds))
  (ivory-themes-load (ivory-themes--current-theme))
  (message "Ivory soft backgrounds %s"
           (if ivory-themes-soft-backgrounds "enabled" "disabled")))

(defun ivory-themes--apply (theme variant)
  "Apply THEME using the palette for VARIANT."
  (let ((palette (ivory-themes--palette variant)))
    (apply #'custom-theme-set-faces theme (ivory-themes--all-faces palette))
    (apply #'custom-theme-set-variables theme (ivory-themes--variables palette))))

;;;###autoload
(when (and (boundp 'custom-theme-load-path) load-file-name)
  (add-to-list 'custom-theme-load-path
               (file-name-as-directory (file-name-directory load-file-name))))

(provide 'ivory-themes)

